@{
    ViewData["Title"] = "Отчёты";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true">
}

<div class="report-controls">
    <div class="generate-group">
        <h2>Отчет по пользователям</h2>

        <div class="date-group">
            <label for="inputFromDateTime">Зарегистрированы с:</label>
            <input type="date" id="inputFromDate" />
        </div>

        <div class="date-group">
            <label for="inputToDateTime">По:</label>
            <input type="date" id="inputToDate" />
        </div>

        <div class="checkbox-group">
            <label for="user-status">Включать активных:</label>
            <div class="checkbox-wrapper">
                <div class="round">
                    <input type="checkbox"
                           name="user-status"
                           id="is-active" checked>
                    <label for="is-active"></label>
                </div>
            </div>
        </div>

        <div class="checkbox-group">
            <label for="user-status">Включать заблокированных:</label>
            <div class="checkbox-wrapper">
                <div class="round">
                    <input type="checkbox"
                           name="user-status"
                           id="is-blocked" checked>
                    <label for="is-blocked"></label>
                </div>
            </div>
        </div>
        
        <button class="generate-users-report-btn">Сгенерировать</button>
    </div>

    <div class="generate-group">
        <h2>Отчет по событиям</h2>

        <div class="date-group">
            <label for="inputFromDateTime">Старт событий с:</label>
            <input type="date" id="inputFromDate" />
        </div>

        <div class="date-group">
            <label for="inputToDateTime">По:</label>
            <input type="date" id="inputToDate" />
        </div>
        
        <div class="status-group">
            <label for="status-select">Статус события:</label>
            <select class="event-status-select" name="status-select">
                <option value="Draft">Черновик</option>
                <option value="Published">Опубликовано</option>
                <option value="InProgress">Идёт</option>
                <option value="Completed" selected>Завершено</option>
                <option value="Cancelled">Отменено</option>
                <option value="">Не указывать</option>
            </select>
        </div>

        <button class="generate-events-report-btn">Сгенерировать</button>
    </div>

    <div class="generate-group">
        <h2>Отчет по посещениям</h2>

        <div class="date-group">
            <label for="inputFromDateTime">Старт событий с:</label>
            <input type="date" id="inputFromDate" />
        </div>

        <div class="date-group">
            <label for="inputToDateTime">По:</label>
            <input type="date" id="inputToDate" />
        </div>
        
        <div class="status-group">
            <label for="status-select">Статус посещения:</label>
            <select class="participation-status-select" name="status-select">
                <option value="Approved">Подтверждено</option>
                <option value="Pending" selected>На проверке</option>
                <option value="Rejected">Отклонено</option>
                <option value="">Не указывать</option>
            </select>
        </div>

        <div class="checkbox-group">
            <label for="moderated-status">Включать не отредактированные часы:</label>
            <div class="checkbox-wrapper">
                <div class="round">
                    <input type="checkbox"
                           name="not-moderated-status"
                           id="is-not-moderated" checked>
                    <label for="is-not-moderated"></label>
                </div>
            </div>
        </div>

        <div class="checkbox-group">
            <label for="moderated-status">Включать отредактированные часы:</label>
            <div class="checkbox-wrapper">
                <div class="round">
                    <input type="checkbox"
                           name="moderated-status"
                           id="is-moderated" checked>
                    <label for="is-moderated"></label>
                </div>
            </div>
        </div>
        
        <button class="generate-hours-report-btn">Сгенерировать</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}