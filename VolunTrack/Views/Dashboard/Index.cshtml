@using VolunTrack.DTO;

@{
    ViewData["Title"] = "Главная";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true">
}

<div class="dashboard-grid">
    <div class="user-section">
        <div class="user-info-card">
            <img src="@UserDto.GetAvatarByRole(Model.CurrentUser.Role)"
                 alt="Avatar"
                 class="user-avatar" />
            <div class="user-info">
                <h1>@Model.CurrentUser.FullName</h1>
                <p>@Model.CurrentUser.Email</p>
                <p>Роль: @UserDto.GetRoleName(Model.CurrentUser.Role)</p>
                <a asp-controller="Profile" asp-action="Edit">Редактировать профиль</a>
            </div>
        </div>
    </div>
    <div style="border-left: 2px solid;"></div>
    <div class="events-section">
        <div class="events-header">
            <h1>Предстоящие события</h1>
                <p>Обновлено: <span class="last-updated-datetime" id="last-updated-datetime"></span></p>
        </div>

        <div class="events-container" id="events-container"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}