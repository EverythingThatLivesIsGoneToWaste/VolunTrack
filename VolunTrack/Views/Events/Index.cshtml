@{
    ViewData["Title"] = "Список событий";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true">
}

<div class="events-header">
    <div class="events-header-top">
            @if (User.IsInRole("EventCoordinator"))
            {
                <h1>Мои события</h1>
            }
            else if (User.IsInRole("RegionCoordinator") || User.IsInRole("Administrator"))
            {
                <h1>Все события</h1>
            }

        @if (User.IsInRole("EventCoordinator") || User.IsInRole("Administrator"))
        {
            <a asp-action="Add" class="btn-create-event">Создать событие</a>
        }
    </div>

    <div class="last-updated-datetime">Обновлено: <span id="last-updated-datetime"></span></div>
</div>

<div class="events-container" id="events-container"></div>

@section Scripts {
    <script src="~/js/events.js" asp-append-version="true"></script>
}