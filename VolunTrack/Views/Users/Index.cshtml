@using System.Security.Claims

@{
    ViewData["Title"] = "Управление пользователями";
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true">
}

<div class="users-header">
    <h1>Пользователи</h1>

    <div class="search-section">
        <input type="text" id="searchInput" placeholder="Поиск по логину, имени, email..." class="search-input">
        <button id="searchButton" class="search-button">🔍 Найти</button>
        <button id="resetButton" class="reset-button">Сбросить</button>
    </div>

    <div class="last-updated-datetime">Обновлено: <span id="last-updated-datetime"></span></div>
</div>


<div class="users-container" id="users-container"></div>

@section Scripts {
    <script src="~/js/users.js" asp-append-version="true"></script>
}