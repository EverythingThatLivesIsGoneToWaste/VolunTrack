﻿@using VolunTrack.DTO

@{
    ViewData["Title"] = "Регистрация";
}

@section Styles {
    <link rel="stylesheet" href="~/css/registration.css" asp-append-version="true">
}

@model RegisterDto

<form id="registerForm" method="post" asp-controller="Registration" asp-action="Index">

    <h1>Зарегистрироваться<br>как волонтёр</h1>
    <div class="input-group">
        <label for="inputLogin">Придумайте логин</label>
        <input type="text" id="inputLogin" asp-for="Login" maxlength="50">
    </div>

    <div class="input-group">
        <label for="inputFullName">Как вас зовут?</label>
        <input type="text" id="inputFullName" asp-for="FullName" maxlength="200">
    </div>

    <div class="input-group">
        <label for="inputPhone">Ваш номер телефона</label>
        <input type="text" id="inputPhone" asp-for="Phone" maxlength="20">
    </div>

    <div class="input-group">
        <label for="inputEmail">Ваша электронная почта</label>
        <input type="email" id="inputEmail" asp-for="Email" maxlength="100">
    </div>

    <div class="input-group">
        <label for="inputPassword">Создайте пароль</label>
        <input type="password" id="inputPassword" asp-for="Password">
    </div>

    <div class="input-group">
        <label for="inputAgainPassword">Повторите пароль</label>
        <input type="password" id="inputAgainPassword">
    </div>

    <div class="input-group" id="categories-selection">
        <p>Выберите, чем вы интересуетесь/в чем имеете навыки</p>
        <div class="categories-container" id="categories-container">

        </div>
    </div>

    <button type="submit" id="RegisterButton" class="submit-button">Регистрация</button>
</form>

<div id="serverErrorSummary" asp-validation-summary="ModelOnly" class="text-danger"></div>

<div id="clientErrorSummary" class="text-danger" style="display: none"></div>

@section Scripts {
    <script src="~/js/registration.js" asp-append-version="true"></script>
}
    